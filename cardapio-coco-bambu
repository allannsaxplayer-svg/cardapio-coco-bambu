ITEMS.forEach((it,i)=>{ it.id = "d"+i; if(!it.all) it.all=[]; if(!it.foreign) it.foreign=[]; });

const ALLERGEN_LABELS = {
  gluten:"Glúten", laticinios:"Laticínios", ovo:"Ovo", crustaceos:"Crustáceos",
  moluscos:"Moluscos", peixe:"Peixe", castanhas:"Castanhas/Nozes", alcool:"Álcool"
};

// ---------- persistence ----------
let srsState = {};     // id -> {box, due}
let tableNotes = {};   // id -> string
const DAY = 86400000;
const BOX_INTERVALS = [0,1,3,7,14,30];

async function loadState(){
  try{
    const v = localStorage.getItem('cardapio-srs-state');
    if(v) srsState = JSON.parse(v);
  }catch(e){}
  try{
    const v2 = localStorage.getItem('cardapio-table-notes');
    if(v2) tableNotes = JSON.parse(v2);
  }catch(e){}
}
async function saveSrs(){
  try{ localStorage.setItem('cardapio-srs-state', JSON.stringify(srsState)); }catch(e){}
}
async function saveNotes(){
  try{ localStorage.setItem('cardapio-table-notes', JSON.stringify(tableNotes)); }catch(e){}
}

function getBox(id){ return (srsState[id] && srsState[id].box) || 0; }
function getDue(id){ return srsState[id] ? srsState[id].due : 0; }
function isDue(id){ const d = getDue(id); return !d || d <= Date.now(); }
function grade(id, hit){
  let box = getBox(id);
  box = hit ? Math.min(box+1, 5) : Math.max(box-1, 0);
  const due = Date.now() + BOX_INTERVALS[box]*DAY;
  srsState[id] = {box, due};
  saveSrs();
  renderStats();
}

// ---------- rendering ----------
const catGrid = document.getElementById('cat-grid');
function renderCategories(filterText){
  catGrid.innerHTML = '';
  const ft = (filterText||'').trim().toLowerCase();
  CATEGORIES.forEach(cat=>{
    let items = ITEMS.filter(i=>i.cat===cat.id);
    if(ft){
      items = items.filter(i => i.name.toLowerCase().includes(ft) || i.desc.toLowerCase().includes(ft) || i.all.some(a=>ALLERGEN_LABELS[a].toLowerCase().includes(ft)));
      if(items.length===0) return;
    }
    const mastered = items.filter(i=>getBox(i.id)>=4).length;
    const div = document.createElement('div');
    div.className = 'cat-card';
    div.innerHTML = `
      <div class="num">${String(cat.id).padStart(2,'0')}</div>
      <div class="name">${cat.name}</div>
      <div class="count">${items.length} itens · ${mastered} dominados</div>
      <div class="bar"><div style="width:${items.length? (mastered/items.length*100):0}%"></div></div>
    `;
    div.onclick = ()=> openStudy(items, cat.name);
    catGrid.appendChild(div);
  });
  if(ft && catGrid.innerHTML==='') catGrid.innerHTML = '<div class="empty-state">Nada encontrado.</div>';
}

document.getElementById('search-input').addEventListener('input', e=> renderCategories(e.target.value));

// ---------- study / flashcards ----------
let studyQueue = [];
let studyIdx = 0;
let flipped = false;

function openStudy(items, label){
  studyQueue = items.slice();
  studyIdx = 0; flipped = false;
  switchView('study');
  renderCard();
}

document.getElementById('btn-due').onclick = ()=>{
  const due = ITEMS.filter(i=>isDue(i.id));
  studyQueue = due.length? due : ITEMS.slice();
  studyIdx = 0; flipped=false; renderCard();
};
document.getElementById('btn-all').onclick = ()=>{
  studyQueue = ITEMS.slice();
  studyIdx = 0; flipped=false; renderCard();
};

const studyArea = document.getElementById('study-area');

function renderCard(){
  if(!studyQueue.length){
    studyArea.innerHTML = '<div class="empty-state">Escolha uma categoria em "Categorias" ou clique em "Estudar tudo".</div>';
    return;
  }
  const it = studyQueue[studyIdx];
  const cat = CATEGORIES.find(c=>c.id===it.cat);

  let allergenHtml, allergenFootnote;
  const declaredCodes = it.all.filter(a=>a!=='alcool');
  if(it.undeclared){
    allergenHtml = declaredCodes.length
      ? declaredCodes.map(a=>`<span class="allergen-chip">${ALLERGEN_LABELS[a]}</span>`).join('')
      : `<span class="allergen-chip none">Não declarado no cartão</span>`;
    allergenFootnote = 'A casa não declarou alergênicos para este item no cartão — isso não significa ausência. Confirme sempre com a cozinha.';
  } else {
    allergenHtml = declaredCodes.length
      ? declaredCodes.map(a=>`<span class="allergen-chip">${ALLERGEN_LABELS[a]}</span>`).join('')
      : `<span class="allergen-chip none">Sem alergênicos declarados pela casa</span>`;
    allergenFootnote = 'Alergênicos conforme declarado oficialmente pela casa. Em caso de dúvida, confirme na cozinha.';
  }
  if(it.all.includes('alcool')){
    allergenHtml += `<span class="allergen-chip">Contém álcool</span>`;
  }

  const priceLabel = it.prices.length>1
    ? `R$ ${Math.min(...it.prices).toFixed(2).replace('.',',')} – R$ ${Math.max(...it.prices).toFixed(2).replace('.',',')}`
    : `R$ ${(it.prices[0]||0).toFixed(2).replace('.',',')}`;

  const portionRows = it.prices.map((p,pi)=>{
    const lab = it.portions[pi];
    const priceTxt = `R$ ${p.toFixed(2).replace('.',',')}`;
    const fallback = it.prices.length>1 ? 'porção não especificada no cardápio' : 'porção única';
    return `<div class="portion-row"><span class="portion-label">${lab ? lab : fallback}</span><span class="portion-price">${priceTxt}</span></div>`;
  }).join('');

  const pronHtml = it.foreign.length ? it.foreign.map((f,fi)=>
    `<button class="pron-btn" data-term="${encodeURIComponent(f.term)}" data-lang="${f.lang}">🔊 ${f.term} <span style="opacity:.7">(${f.hint})</span></button>`
  ).join('') : '<span class="allergen-note">Sem termos estrangeiros neste prato.</span>';
  const note = tableNotes[it.id] || '';

  studyArea.innerHTML = `
    <div class="card-wrap">
      <div class="flashcard ${flipped?'flipped':''}" id="flashcard">
        <div class="face front">
          <div class="cat-tag">${cat.name}</div>
          <div class="dish-name">${it.name}</div>
          <div class="price">${priceLabel}${it.prices.length>1?' <span style="opacity:.6">('+it.prices.length+' porções)</span>':''}</div>
          <div class="tap-hint">toque para ver a aula</div>
        </div>
        <div class="face back">
          <div class="dish-name-small">${it.name}</div>
          <div class="desc">${it.desc}</div>

          <div class="row-label">Porção(ões) e preço(s)</div>
          <div class="portion-block">${portionRows}</div>

          <div class="row-label">Alérgenos (declarados pela casa)</div>
          <div class="allergen-row">${allergenHtml}</div>
          <div class="allergen-note">${allergenFootnote}</div>

          <div class="row-label">Pronúncia</div>
          <div class="pron-row">${pronHtml}</div>

          <div class="row-label">Montagem de mesa (você preenche)</div>
          <div class="table-note">
            <textarea placeholder="Ex: guardanapo + garfo e faca grande, +1 colher de servir…">${note}</textarea>
          </div>

          <div class="grade-row">
            <button class="grade-btn miss">Ainda não sei</button>
            <button class="grade-btn hit">Já sei bem</button>
          </div>
        </div>
      </div>
    </div>
    <div class="nav-arrows sans">
      <button id="prev-card">← Anterior</button>
      <span style="color:var(--ink-dim); font-size:12px;">${studyIdx+1} / ${studyQueue.length}</span>
      <button id="next-card">Próximo →</button>
    </div>
  `;

  const flashcardEl = document.getElementById('flashcard');
  flashcardEl.querySelector('.face.front').onclick = ()=>{ flipped=true; flashcardEl.classList.add('flipped'); };
  flashcardEl.querySelector('.face.back .dish-name-small').onclick = ()=>{ flipped=false; flashcardEl.classList.remove('flipped'); };

  studyArea.querySelectorAll('.pron-btn').forEach(btn=>{
    btn.onclick = (e)=>{
      e.stopPropagation();
      const term = decodeURIComponent(btn.dataset.term);
      const lang = btn.dataset.lang;
      speak(term, lang);
    };
  });

  const textarea = studyArea.querySelector('textarea');
  textarea.addEventListener('click', e=>e.stopPropagation());
  textarea.addEventListener('input', e=>{
    tableNotes[it.id] = e.target.value;
    saveNotes();
  });

  studyArea.querySelector('.grade-btn.miss').onclick = (e)=>{ e.stopPropagation(); grade(it.id,false); nextCard(); };
  studyArea.querySelector('.grade-btn.hit').onclick = (e)=>{ e.stopPropagation(); grade(it.id,true); nextCard(); };

  document.getElementById('prev-card').onclick = ()=>{ studyIdx = (studyIdx-1+studyQueue.length)%studyQueue.length; flipped=false; renderCard(); };
  document.getElementById('next-card').onclick = nextCard;
}
function nextCard(){ studyIdx = (studyIdx+1)%studyQueue.length; flipped=false; renderCard(); }

function speak(term, lang){
  if(!('speechSynthesis' in window)){ return; }
  const u = new SpeechSynthesisUtterance(term);
  u.lang = lang || 'pt-BR';
  u.rate = 0.85;
  speechSynthesis.cancel();
  speechSynthesis.speak(u);
}

// ---------- quiz / simulation mode ----------
const quizArea = document.getElementById('quiz-area');
function allergenAnswer(it, code, label){
  if(it.all.includes(code)) return `A casa declara ${label} nesse item — avise o cliente antes de recomendar. (${it.name}: ${it.desc})`;
  if(it.undeclared) return `A casa não declarou alergênicos para esse item no cartão — não é garantia de ausência de ${label}. Confirme direto com a cozinha antes de responder ao cliente.`;
  return `A casa declara alergênicos para esse item, e ${label} não está entre eles — mas sempre reconfirme com a cozinha se o cliente tiver uma restrição séria.`;
}
const SCENARIO_TEMPLATES = [
  it => ({q:`Um cliente pergunta: "O que vem no ${it.name}?" O que você responde?`, a: it.desc}),
  it => ({q:`Cliente com intolerância a glúten pergunta se pode pedir "${it.name}". O que você diz?`, a: allergenAnswer(it,'gluten','glúten')}),
  it => ({q:`Cliente com intolerância a lactose pergunta sobre o "${it.name}". O que você diz?`, a: allergenAnswer(it,'laticinios','laticínios/lactose')}),
  it => ({q:`Cliente alérgico a crustáceos pergunta se pode comer o "${it.name}". O que você diz?`, a: allergenAnswer(it,'crustaceos','crustáceos')}),
  it => ({q:`Um cliente pede uma sugestão de bebida ou harmonização para o "${it.name}". Antes de responder, o que você precisa lembrar sobre esse prato?`, a: it.desc}),
];

function newQuiz(){
  const it = ITEMS[Math.floor(Math.random()*ITEMS.length)];
  const tpl = SCENARIO_TEMPLATES[Math.floor(Math.random()*SCENARIO_TEMPLATES.length)];
  const {q,a} = tpl(it);
  quizArea.innerHTML = `
    <div class="quiz-box">
      <h3>Simulação de atendimento</h3>
      <div class="scenario">${q}</div>
      <button class="mode-btn primary" id="reveal-btn" style="width:100%;">Mostrar resposta correta</button>
      <div class="quiz-feedback hidden" id="quiz-feedback"></div>
      <button class="next-q hidden" id="next-quiz">Próxima simulação</button>
    </div>
  `;
  document.getElementById('reveal-btn').onclick = ()=>{
    const fb = document.getElementById('quiz-feedback');
    fb.textContent = a;
    fb.classList.remove('hidden');
    document.getElementById('reveal-btn').classList.add('hidden');
    document.getElementById('next-quiz').classList.remove('hidden');
  };
  document.getElementById('next-quiz').onclick = newQuiz;
}

// ---------- tabs / view switching ----------
function switchView(view){
  document.getElementById('view-home').classList.toggle('hidden', view!=='home');
  document.getElementById('view-study').classList.toggle('hidden', view!=='study');
  document.getElementById('view-quiz').classList.toggle('hidden', view!=='quiz');
  document.querySelectorAll('.tab-btn').forEach(b=> b.classList.toggle('active', b.dataset.view===view));
  if(view==='quiz') newQuiz();
  if(view==='study' && !studyQueue.length) studyArea.innerHTML = '<div class="empty-state">Escolha uma categoria em "Categorias" ou clique em "Estudar tudo".</div>';
}
document.getElementById('tabs').addEventListener('click', e=>{
  const btn = e.target.closest('.tab-btn');
  if(!btn) return;
  switchView(btn.dataset.view);
});

// ---------- stats ----------
function renderStats(){
  document.getElementById('stat-total').textContent = ITEMS.length;
  document.getElementById('stat-mastered').textContent = ITEMS.filter(i=>getBox(i.id)>=4).length;
  const dueCount = ITEMS.filter(i=>isDue(i.id) && srsState[i.id]).length;
  document.getElementById('stat-due').textContent = dueCount;
  document.getElementById('due-count').textContent = ITEMS.filter(i=>isDue(i.id)).length;
}

// ---------- init ----------
(async function init(){
  await loadState();
  renderCategories();
  renderStats();
})();

})();
</script>
</body>
</html>
