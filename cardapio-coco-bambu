<!DOCTYPE html>
<html lang="pt-BR">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1, user-scalable=no">
<title>Cardápio na Ponta da Língua — Coco Bambu Flamboyant</title>
<style>
  :root{
    --bg: #0b2b33;
    --bg-2: #0e3640;
    --card: #123f49;
    --card-2: #163f4a;
    --ink: #eef4f1;
    --ink-dim: #a9c2bd;
    --gold: #d8a441;
    --gold-soft: #e8c37a;
    --coral: #e85d4e;
    --coral-soft: #f2988a;
    --teal-line: #1c5561;
    --ok: #6fb98f;
    --radius: 14px;
    font-family: 'Fraunces', Georgia, serif;
  }
  @font-face{
    font-family:'Fraunces';
    src: local('Georgia');
  }
  *{ box-sizing: border-box; }
  html,body{ margin:0; padding:0; background:var(--bg); color:var(--ink); }
  body{
    font-family: 'Iowan Old Style', 'Palatino Linotype', Georgia, serif;
    min-height:100vh;
    background:
      radial-gradient(ellipse at top left, rgba(216,164,65,0.10), transparent 45%),
      radial-gradient(ellipse at bottom right, rgba(232,93,78,0.08), transparent 50%),
      linear-gradient(180deg, var(--bg) 0%, var(--bg-2) 100%);
  }
  .sans{ font-family: 'Avenir Next', 'Segoe UI', -apple-system, sans-serif; }
  a{ color:inherit; }

  header.top{
    padding: 22px 18px 16px;
    text-align:center;
    border-bottom: 1px solid var(--teal-line);
    position: sticky; top:0; z-index: 30;
    background: rgba(11,43,51,0.92);
    backdrop-filter: blur(6px);
  }
  header.top .eyebrow{
    font-family:'Avenir Next','Segoe UI',sans-serif;
    letter-spacing:3px; text-transform:uppercase; font-size:11px;
    color: var(--gold-soft); margin-bottom:4px;
  }
  header.top h1{
    margin:0; font-size: 22px; font-weight: 600; letter-spacing:0.3px;
  }
  header.top h1 .accent{ color: var(--gold); font-style: italic; }
  .stats-strip{
    display:flex; justify-content:center; gap:18px; margin-top:10px;
    font-family:'Avenir Next','Segoe UI',sans-serif; font-size:12px; color:var(--ink-dim);
  }
  .stats-strip b{ color: var(--gold-soft); font-weight:700;}

  nav.tabs{
    display:flex; gap:6px; padding: 10px 12px; overflow-x:auto;
    border-bottom:1px solid var(--teal-line);
    position: sticky; top: 84px; z-index: 25;
    background: rgba(11,43,51,0.92); backdrop-filter: blur(6px);
    scrollbar-width: none;
  }
  nav.tabs::-webkit-scrollbar{ display:none; }
  .tab-btn{
    font-family:'Avenir Next','Segoe UI',sans-serif; font-size:13px; font-weight:600;
    white-space:nowrap; padding: 8px 14px; border-radius: 100px; border:1px solid var(--teal-line);
    background: transparent; color: var(--ink-dim); cursor:pointer;
  }
  .tab-btn.active{ background: var(--gold); color:#1a1206; border-color: var(--gold); }

  main{ max-width: 640px; margin: 0 auto; padding: 16px 14px 60px; }

  .search-row{ display:flex; gap:8px; margin-bottom:14px; }
  .search-row input{
    flex:1; padding: 11px 14px; border-radius: 100px; border:1px solid var(--teal-line);
    background: var(--card); color: var(--ink); font-family:'Avenir Next','Segoe UI',sans-serif; font-size:14px;
  }
  .search-row input::placeholder{ color: var(--ink-dim); }

  .section-divider{
    display:flex; align-items:center; gap:10px; margin: 22px 0 12px;
    font-family:'Avenir Next','Segoe UI',sans-serif; text-transform:uppercase; letter-spacing:2px;
    font-size:11px; color: var(--gold-soft);
  }
  .section-divider::before, .section-divider::after{ content:''; flex:1; height:1px; background: var(--teal-line); }

  .cat-grid{ display:grid; grid-template-columns: 1fr 1fr; gap:10px; }
  .cat-card{
    background: linear-gradient(160deg, var(--card), var(--card-2));
    border:1px solid var(--teal-line); border-radius: var(--radius);
    padding: 14px; cursor:pointer; text-align:left;
    display:flex; flex-direction:column; gap:6px;
  }
  .cat-card .num{ font-size:11px; color:var(--gold-soft); font-family:'Avenir Next','Segoe UI',sans-serif; }
  .cat-card .name{ font-size:15px; font-weight:600; line-height:1.25; }
  .cat-card .count{ font-family:'Avenir Next','Segoe UI',sans-serif; font-size:11px; color:var(--ink-dim); }
  .cat-card .bar{ height:4px; border-radius:4px; background: rgba(255,255,255,0.08); overflow:hidden; margin-top:2px;}
  .cat-card .bar > div{ height:100%; background: var(--gold); }

  .mode-row{ display:flex; gap:10px; margin: 4px 0 18px; }
  .mode-btn{
    flex:1; padding:12px; border-radius:12px; border:1px solid var(--teal-line);
    background: var(--card); color:var(--ink); font-family:'Avenir Next','Segoe UI',sans-serif;
    font-weight:700; font-size:13px; cursor:pointer; text-align:center;
  }
  .mode-btn.primary{ background: var(--coral); border-color: var(--coral); color:#2a0b06;}

  /* Flashcard */
  .card-wrap{ perspective: 1400px; margin-bottom: 16px; }
  .flashcard{
    position:relative; min-height: 300px; border-radius: 18px;
    transform-style: preserve-3d; transition: transform 0.5s cubic-bezier(.2,.8,.2,1);
    cursor:pointer;
  }
  .flashcard.flipped{ transform: rotateY(180deg); }
  .face{
    position:absolute; inset:0; backface-visibility:hidden; border-radius:18px;
    border:1px solid var(--teal-line); padding:22px; display:flex; flex-direction:column;
  }
  .face.front{
    background: linear-gradient(160deg, #154853, #0f3b45);
    justify-content:center; align-items:center; text-align:center; gap:10px;
  }
  .face.front .cat-tag{ font-family:'Avenir Next','Segoe UI',sans-serif; font-size:11px; letter-spacing:2px; text-transform:uppercase; color:var(--gold-soft);}
  .face.front .dish-name{ font-size:26px; font-weight:600; line-height:1.2; }
  .face.front .price{ font-family:'Avenir Next','Segoe UI',sans-serif; color:var(--ink-dim); font-size:14px; }
  .face.front .tap-hint{ margin-top:14px; font-family:'Avenir Next','Segoe UI',sans-serif; font-size:11px; color:var(--gold-soft); border:1px solid var(--gold-soft); padding:5px 12px; border-radius:100px;}
  .face.front .diet-badges{ display:flex; gap:6px; flex-wrap:wrap; justify-content:center; margin-top:6px;}
  .badge{ font-family:'Avenir Next','Segoe UI',sans-serif; font-size:10px; font-weight:700; padding:3px 9px; border-radius:100px; }
  .badge.vegano{ background:#284d2f; color:#a6e6b4; }
  .badge.vegetariano{ background:#2c4d3a; color:#b6e6c9; }
  .badge.kids{ background:#3a3560; color:#c3bdf0; }

  .face.back{
    background: linear-gradient(160deg, var(--card), var(--card-2));
    transform: rotateY(180deg); overflow-y:auto; gap:12px;
  }
  .face.back .dish-name-small{ font-size:17px; font-weight:700; margin-bottom:2px;}
  .face.back .desc{ font-family:'Avenir Next','Segoe UI',sans-serif; font-size:13.5px; line-height:1.55; color: var(--ink); }
  .row-label{ font-family:'Avenir Next','Segoe UI',sans-serif; font-size:10.5px; text-transform:uppercase; letter-spacing:1.5px; color:var(--gold-soft); margin-top:6px; }
  .allergen-row{ display:flex; flex-wrap:wrap; gap:6px; }
  .allergen-chip{ font-family:'Avenir Next','Segoe UI',sans-serif; font-size:11.5px; padding:4px 10px; border-radius:100px; background: rgba(232,93,78,0.16); color: var(--coral-soft); border:1px solid rgba(232,93,78,0.4);}
  .allergen-chip.none{ background: rgba(111,185,143,0.14); color: var(--ok); border-color: rgba(111,185,143,0.4);}
  .allergen-note{ font-family:'Avenir Next','Segoe UI',sans-serif; font-size:11px; color: var(--ink-dim); font-style:italic; }

  .portion-block{ display:flex; flex-direction:column; gap:5px; }
  .portion-row{
    display:flex; justify-content:space-between; align-items:center; gap:10px;
    font-family:'Avenir Next','Segoe UI',sans-serif; font-size:12.5px;
    background: rgba(216,164,65,0.08); border:1px solid rgba(216,164,65,0.25);
    border-radius:8px; padding:6px 10px;
  }
  .portion-label{ color: var(--ink); }
  .portion-price{ color: var(--gold-soft); font-weight:700; white-space:nowrap; }

  .pron-row{ display:flex; flex-wrap:wrap; gap:8px; }
  .pron-btn{
    font-family:'Avenir Next','Segoe UI',sans-serif; font-size:12px; background: rgba(216,164,65,0.14);
    color: var(--gold-soft); border:1px solid rgba(216,164,65,0.4); padding:6px 11px; border-radius:100px;
    cursor:pointer; display:flex; align-items:center; gap:5px;
  }

  .table-note textarea{
    width:100%; min-height:52px; border-radius:10px; border:1px solid var(--teal-line);
    background: rgba(0,0,0,0.18); color:var(--ink); font-family:'Avenir Next','Segoe UI',sans-serif;
    font-size:12.5px; padding:8px 10px; resize: vertical;
  }

  .grade-row{ display:flex; gap:8px; margin-top:6px; }
  .grade-btn{
    flex:1; padding:10px; border-radius:10px; border:none; cursor:pointer;
    font-family:'Avenir Next','Segoe UI',sans-serif; font-weight:700; font-size:12.5px;
  }
  .grade-btn.miss{ background: rgba(232,93,78,0.85); color:#2a0b06; }
  .grade-btn.hit{ background: rgba(111,185,143,0.9); color:#062a12; }

  .nav-arrows{ display:flex; justify-content:space-between; margin-top:6px; }
  .nav-arrows button{
    background:none; border:none; color: var(--gold-soft); font-family:'Avenir Next','Segoe UI',sans-serif;
    font-size:13px; cursor:pointer; padding:8px;
  }

  /* Quiz mode */
  .quiz-box{
    background: linear-gradient(160deg, var(--card), var(--card-2)); border:1px solid var(--teal-line);
    border-radius:18px; padding:20px;
  }
  .quiz-box h3{ margin:0 0 4px; font-size:17px; }
  .quiz-box .scenario{ font-family:'Avenir Next','Segoe UI',sans-serif; font-size:13.5px; color:var(--ink-dim); margin-bottom:14px; line-height:1.5;}
  .opt-list{ display:flex; flex-direction:column; gap:8px; }
  .opt-btn{
    text-align:left; padding:12px 14px; border-radius:12px; border:1px solid var(--teal-line);
    background: rgba(0,0,0,0.15); color: var(--ink); font-family:'Avenir Next','Segoe UI',sans-serif;
    font-size:13.5px; cursor:pointer;
  }
  .opt-btn.correct{ background: rgba(111,185,143,0.25); border-color: var(--ok); }
  .opt-btn.wrong{ background: rgba(232,93,78,0.25); border-color: var(--coral); }
  .quiz-feedback{ font-family:'Avenir Next','Segoe UI',sans-serif; font-size:12.5px; margin-top:12px; color:var(--gold-soft); line-height:1.5;}
  .next-q{ margin-top:14px; width:100%; padding:11px; border-radius:10px; border:none; background:var(--gold); color:#1a1206; font-weight:700; font-family:'Avenir Next','Segoe UI',sans-serif; cursor:pointer;}

  footer.disclaimer{
    max-width:640px; margin: 30px auto 10px; padding: 0 14px;
    font-family:'Avenir Next','Segoe UI',sans-serif; font-size:11px; color: var(--ink-dim);
    line-height:1.6; text-align:center;
  }
  .hidden{ display:none !important; }
  .empty-state{ text-align:center; padding: 40px 20px; color: var(--ink-dim); font-family:'Avenir Next','Segoe UI',sans-serif; font-size:13px;}
</style>
</head>
